filters:
  and:
    - file.path.contains("DS compendium/Rules/Classes/Conduit")
views:
  - type: table
    name: Table
    filters:
      and:
        - Class == "conduit"
    order:
      - file.name
      - subclass
      - ability_type
      - type
    sort:
      - property: type
        direction: ASC
      - property: ability_type
        direction: ASC
