filters:
  and:
    - file.path.contains("DS Compendium/Rules/Careers")
views:
  - type: table
    name: Career
    filters:
      and:
        - type == "career"
    order:
      - file.name
      - description
      - skills
      - languages
      - projectpoints
      - perks
      - wealth
      - renown
    columnSize:
      file.name: 128
      note.description: 544
      note.skills: 499
      note.languages: 77
      note.perks: 119
      note.wealth: 74
    indentProperties: true
    cardSize: 200
