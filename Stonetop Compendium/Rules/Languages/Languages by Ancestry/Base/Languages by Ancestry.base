filters:
  and:
    - file.path.contains("DS Compendium/Rules/Languages")
properties:
  file.name:
    displayName: Language
views:
  - type: table
    name: Table
    filters:
      and:
        - langbyancestry == "yes"
    order:
      - file.name
      - ancestry
      - notes
    indentProperties: false
