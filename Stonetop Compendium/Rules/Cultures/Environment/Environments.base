filters:
  and:
    - file.path.contains("DS Compendium/Rules/Cultures")
properties:
  note.culture_benefit_type:
    displayName: Type
views:
  - type: list
    name: Table
    filters:
      and:
        - Culture == "Yes"
        - type == "environment"
    order:
      - file.name
      - skill options
      - description
    sort:
      - property: culture_benefit_type
        direction: ASC
      - property: description
        direction: DESC
      - property: skill options
        direction: ASC
      - property: file.basename
        direction: ASC
    cardSize: 570
    columnSize:
      note.culture_benefit_type: 118
      note.skill options: 421
    markers: none
    indentProperties: true
