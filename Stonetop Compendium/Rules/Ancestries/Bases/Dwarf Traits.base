filters:
  and:
    - ancestryTrait == "Yes"
    - file.path.contains("ds compendium/rules/ancestries/")
views:
  - type: table
    name: Table
    filters:
      and:
        - ancestry == ["Dwarf"]
    order:
      - file.name
      - ancestry
      - type
      - cost
      - description
    sort:
      - property: type
        direction: DESC
      - property: cost
        direction: ASC
  - type: table
    name: Devil
    filters:
      and:
        - ancestry == ["Devil"]
    order:
      - file.name
      - ancestry
      - type
      - cost
      - description
    sort:
      - property: type
        direction: DESC
