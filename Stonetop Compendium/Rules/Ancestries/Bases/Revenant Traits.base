filters:
  and:
    - ancestryTrait == "Yes"
    - file.path.contains("ds compendium/rules/ancestries/")
views:
  - type: table
    name: Table
    filters:
      and:
        - ancestry == ["Revenant"]
    order:
      - file.name
      - ancestry
      - type
      - cost
      - description
    sort:
      - property: type
        direction: DESC
      - property: cost
        direction: ASC
    columnSize:
      note.ancestry: 97
      note.type: 99
