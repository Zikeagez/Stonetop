{
  "devMode": false,
  "ignoreCodeBlockRestrictions": true,
  "preferredDateFormat": "YYYY-MM-DD",
  "firstWeekday": {
    "index": 1,
    "name": "Monday",
    "shortName": "Mo"
  },
  "syncInterval": 200,
  "enableJs": true,
  "viewFieldDisplayNullAsEmpty": false,
  "enableSyntaxHighlighting": true,
  "enableEditorRightClickMenu": true,
  "inputFieldTemplates": [
    {
      "name": "template-poi-type",
      "declaration": "INPUT[inlineSelect(option(Encounter), option(Ruins), option(Dungeon), option(Landmark))]"
    },
    {
      "name": "template-person-race",
      "declaration": "INPUT[inlineSelect(\n  option(Human),\n  option(Elf),\n  option(Dwarf),\n  option(Halfling),\n  option(Gnome),\n  option(Half-Elf),\n  option(Orc),\n  option(Tiefling),\n  option(Leshy),\n  option(Goblin)\n)]"
    },
    {
      "name": "template-person-gender",
      "declaration": "INPUT[inlineSelect(option(Male), option(Female), option(Other))]"
    },
    {
      "name": "template-group-type",
      "declaration": "INPUT[inlineSelect(option(Knightly Order), option(Religious Order), option(Magic Academy), option(Artisan Guild), option(Merchant Consortium), option(Criminal Syndicate), option(Mercenary Company), option(Noble House), option(Secret Society or Cult), option(Adventurers’ Guild))]"
    },
    {
      "name": "template-hub-category",
      "declaration": "INPUT[inlineListSuggester(option(Alchemical), option(Artifact), option(Consumable), option(Cursed), option(Intelligent), option(Invested), option(Magical), option(Relic), option(Rune), option(Snare), option(Stance), option(Talisman), option(Worn))]"
    },
    {
      "name": "template-person-status",
      "declaration": "INPUT[inlineSelect(option(Alive), option(Dead))]"
    },
    {
      "name": "template-person-age-range",
      "declaration": "INPUT[inlineSelect(option(Infant), option(Child), option(Teenager), option(Young Adult), option(Adult), option(Elder))]"
    },
    {
      "name": "template-place-category",
      "declaration": "INPUT[inlineSelect(option(Commerce), option(Agriculture), option(Military), option(Philosophy), option(Industrial), option(Nesting), option(Government))]"
    },
    {
      "name": "template-person-class",
      "declaration": "INPUT[inlineSelect(option(Artificer), option(Barbarian), option(Bard), option(Cleric), option(Druid), option(Fighter), option(Monk), option(Paladin), option(Ranger), option(Rogue), option(Sorcerer), option(Warlock), option(Wizard))]"
    }
  ],
